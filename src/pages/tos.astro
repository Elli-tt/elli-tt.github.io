---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import {
  discordUrl,
  routes,
  withBasePath
} from '../config/site';

const base = import.meta.env.BASE_URL;
const privacyUrl = withBasePath(base, routes.privacy);
const contactEmail = 'Elliott@ElPlugins.com';

/*
 * REQUIRED BEFORE PUBLISHING:
 * Replace the legal operator name and geographic business address below.
 * Add a company number and VAT number if applicable.
 */
const companyNumber = '';
const vatNumber = '';

const effectiveDate = '10 July 2026';
const lastReviewedDate = '10 July 2026';
---

<BaseLayout
  title="Terms of Service - ElPlugins"
  description="ElPlugins Terms of Service."
>
  <Navbar />

  <main>
    <section class="page-hero">
      <p class="eyebrow">Legal</p>
      <h1>Terms of Service</h1>
      <p>
        Effective {effectiveDate}. Last reviewed {lastReviewedDate}. These terms
        apply to the ElPlugins website, app, plugins, customer support, private
        channels, orders and related digital services.
      </p>

      <div class="page-actions">
        <a class="button discord-button" href={discordUrl}>Contact Support</a>
      </div>
    </section>

    <section class="tos-page">
      <article class="tos-card">
        <h2>Agreement to these terms</h2>

        <p>
          We are ElPlugins, a trading name also referred
          to in these terms as “we”, “us” or “our”.
        </p>

        <p>
          These terms form a legally binding agreement between you and
          ElPlugins. They apply when you visit or use the services, create or use
          an account, place an order, request or receive access, use the app or a
          plugin, join a private channel, or otherwise use any service that links
          to these terms.
        </p>

        <p>
          By using the services, you confirm that you have read and understood
          these terms and agree to be bound by them. If you do not agree, you
          must not use the services or place an order.
        </p>

        <p>
          Nothing in these terms limits any consumer right or remedy that cannot
          lawfully be limited or excluded.
        </p>
      </article>

      <nav class="tos-card tos-toc" aria-labelledby="terms-contents">
        <h2 id="terms-contents">Contents</h2>
        <ol>
          <li><a href="#definitions">Definitions</a></li>
          <li><a href="#eligibility">Eligibility and accounts</a></li>
          <li><a href="#services">Our services and third-party platforms</a></li>
          <li><a href="#orders">Orders, prices, payments and delivery</a></li>
          <li><a href="#cancellation">Cancellation, refunds and statutory rights</a></li>
          <li><a href="#licence">Software licence, intellectual property and HWIDs</a></li>
          <li><a href="#lifetime">Lifetime Access and Product End of Life</a></li>
          <li><a href="#acceptable-use">Acceptable use</a></li>
          <li><a href="#contributions">Contributions, feedback and reviews</a></li>
          <li><a href="#privacy">Privacy</a></li>
          <li><a href="#support">Support, availability, updates and maintenance</a></li>
          <li><a href="#suspension">Suspension and termination</a></li>
          <li><a href="#changes">Changes to the services and these terms</a></li>
          <li><a href="#disclaimers">Disclaimers</a></li>
          <li><a href="#liability">Liability</a></li>
          <li><a href="#disputes">Complaints, governing law and courts</a></li>
          <li><a href="#general">General terms</a></li>
          <li><a href="#contact">Contact and legal information</a></li>
        </ol>
      </nav>

      <article class="tos-card" id="definitions">
        <h2>1. Definitions</h2>

        <dl>
          <dt>Archived Version</dt>
          <dd>
            The final version of a product that we retain after its Product End
            of Life, which may have limited or disabled functionality.
          </dd>

          <dt>Consumer</dt>
          <dd>
            An individual acting wholly or mainly outside their trade, business,
            craft or profession.
          </dd>

          <dt>External Change</dt>
          <dd>
            A change outside our reasonable control that materially affects a
            product’s operation, compatibility, legality, security or
            distribution, as described in Section 7.
          </dd>

          <dt>Fixed-Term Access</dt>
          <dd>
            Access for the period stated on the relevant product page,
            checkout, order confirmation, invoice or support notice.
          </dd>

          <dt>Lifetime Access</dt>
          <dd>
            Access for the Product Lifetime of the specific product purchased,
            as described in Section 7. It does not mean the lifetime of any
            person or business.
          </dd>

          <dt>Product Lifetime</dt>
          <dd>
            The commercial and operational lifetime of a specific product,
            ending only in accordance with Section 7.
          </dd>

          <dt>Services</dt>
          <dd>
            The ElPlugins website, store listings, app, plugins, keys, private
            channels, support, documentation and related digital services.
          </dd>

          <dt>Substantial Redevelopment</dt>
          <dd>
            A material replacement, redesign or rewrite of a product’s codebase
            or architecture that, because of an External Change, would in
            substance amount to developing a materially new product rather than
            maintaining the existing one.
          </dd>
        </dl>
      </article>

      <article class="tos-card" id="eligibility">
        <h2>2. Eligibility and accounts</h2>

        <h3>2.1 Age requirements</h3>
        <p>
          You must be at least 18 years old to place an order or enter into a
          paid contract with us. A person aged 13 to 17 may use non-paid parts
          of the services only with the permission and supervision of a parent
          or legal guardian. Any purchase for a minor must be made by a parent
          or legal guardian who agrees to these terms.
        </p>

        <h3>2.2 Account information</h3>
        <p>
          You must provide accurate, current and complete account, order and
          support information and keep it up to date. You must keep your account,
          keys, app access, plugin files and authentication details secure.
        </p>

        <p>
          You are responsible for activity carried out through your account
          unless it results from our failure to use reasonable care and skill.
          Tell us promptly if you believe your account or access credentials have
          been compromised.
        </p>

        <h3>2.3 Personal use</h3>
        <p>
          Unless a product page expressly states otherwise, the services are
          supplied for your personal, non-commercial use. Access is personal and
          must not be shared, transferred or resold.
        </p>

        <h3>2.4 Restricted and private access</h3>
        <p>
          Access to customer-only channels, private support areas, app features
          and non-public materials is conditional on your continuing compliance
          with these terms.
        </p>

        <p>
          You must not obtain or use private access through deception,
          impersonation, false information or an undisclosed third-party
          instruction for the purpose of unauthorised monitoring, investigation,
          copying or enforcement activity. We may refuse or remove access where
          we reasonably believe that access was obtained or is being used in that
          way.
        </p>

        <p>
          Nothing in this section prevents anyone from reporting suspected
          unlawful conduct to a regulator, law-enforcement body or other
          competent authority, obtaining legal advice, preserving evidence
          lawfully, making a protected disclosure, or complying with a legal
          obligation or court order.
        </p>
      </article>

      <article class="tos-card" id="services">
        <h2>3. Our services and third-party platforms</h2>

        <p>
          We provide plugin access, app access, support and related digital
          services. Some services depend on third-party platforms, applications,
          games, operating systems, APIs, hosting providers, payment processors,
          authentication systems and other external services.
        </p>

        <p>
          Unless we expressly state otherwise, ElPlugins is independent from and
          is not sponsored, endorsed or approved by any third-party platform or
          rights holder. Third-party names and trade marks belong to their
          respective owners.
        </p>

        <p>
          You are responsible for ensuring that your use of the services is
          lawful in your location and complies with any third-party terms that
          apply to you. We do not authorise you to breach a third party’s terms,
          bypass technical restrictions unlawfully, infringe intellectual
          property rights or use the services for any illegal purpose.
        </p>

        <p>
          Product descriptions, compatibility details, required software,
          functionality, access duration, HWID limits and material restrictions
          shown before purchase form part of your contract with us.
        </p>
      </article>

      <article class="tos-card" id="orders">
        <h2>4. Orders, prices, payments and delivery</h2>

        <h3>4.1 Pre-contract information</h3>
        <p>
          Before you place an order, we will provide the main characteristics of
          the product or service, the total price or how it is calculated,
          accepted payment methods, access duration, material compatibility
          information, relevant restrictions and any applicable cancellation
          information.
        </p>

        <p>
          You are responsible for checking the order details and correcting any
          errors before payment. The final checkout action will make clear that
          placing the order creates an obligation to pay.
        </p>

        <h3>4.2 Prices and taxes</h3>
        <p>
          Prices, packages and accepted currencies may change before an order is
          accepted. Taxes, payment-provider fees and currency-conversion charges
          may apply depending on your location and payment method. The total
          amount payable will be shown or explained before you place the order.
        </p>

        <h3>4.3 Order acceptance</h3>
        <p>
          An order is an offer to purchase the relevant access. A contract is
          formed when we send an order confirmation, provide the relevant
          entitlement, or otherwise expressly accept the order.
        </p>

        <p>
          We may reject or cancel an order before delivery because of a genuine
          pricing error, lack of availability, suspected fraud, payment failure,
          legal or security risk, or an apparent breach of these terms. If we
          cancel after taking payment and before supplying the order, we will
          refund the amount paid.
        </p>

        <h3>4.4 Delivery</h3>
        <p>
          Digital access is treated as delivered when the relevant key, file,
          app access, plugin access, account entitlement, private-channel access
          or other agreed means of access has been provided.
        </p>

        <p>
          We will provide an order confirmation and a copy or durable record of
          the applicable contract information by email or another format you can
          save. Contact support if you have paid but have not received access
          within the stated delivery period.
        </p>

        <h3>4.5 Access periods</h3>
        <p>
          Fixed-Term Access lasts for the period stated before purchase and does
          not renew automatically unless automatic renewal is expressly offered
          and accepted.
        </p>

        <p>
          Lifetime Access is governed by Section 7. It does not refer to your
          lifetime, the lifetime of any other person, or the lifetime of
          ElPlugins or its owner.
        </p>
      </article>

      <article class="tos-card" id="cancellation">
        <h2>5. Cancellation, refunds and statutory rights</h2>

        <h3>5.1 Immediate supply of digital content</h3>
        <p>
          Where you ask us to supply digital content immediately during a
          statutory cancellation period, we may require you to give express
          consent for supply to begin and to acknowledge that you will lose your
          right to cancel once supply begins. This consent and acknowledgement
          must be obtained separately at checkout or through another clear
          process; agreement to these terms alone is not treated as that consent.
        </p>

        <p>
          Where the law gives you a cancellation right and the required consent
          or acknowledgement has not been properly obtained, that right is not
          excluded by these terms.
        </p>

        <h3>5.2 Change-of-mind refunds</h3>
        <p>
          Except where a statutory cancellation right applies or we expressly
          offer a separate refund policy, we do not provide change-of-mind
          refunds after digital access has been supplied.
        </p>

        <h3>5.3 Faulty, misdescribed or non-conforming digital content</h3>
        <p>
          Consumers retain all mandatory rights relating to digital content and
          services, including rights where content is not of satisfactory
          quality, is not fit for a disclosed purpose, is not as described, or a
          service is not performed with reasonable care and skill.
        </p>

        <p>
          Depending on the circumstances and applicable law, available remedies
          may include repair, replacement, repeat performance, a price reduction
          or a refund. Nothing in these terms replaces or restricts those
          remedies.
        </p>

        <h3>5.4 Duplicate charges and payment errors</h3>
        <p>
          We will refund confirmed duplicate charges and proven
          payment-processing errors. We may ask for reasonable evidence of the
          transaction.
        </p>

        <h3>5.5 Payment disputes</h3>
        <p>
          Where reasonably possible, contact support before opening a chargeback
          or payment dispute so that we have an opportunity to investigate.
          Nothing in this section prevents you from exercising a legal right or
          using a payment-provider dispute process in good faith.
        </p>
      </article>

      <article class="tos-card" id="licence">
        <h2>6. Software licence, intellectual property and HWIDs</h2>

        <h3>6.1 Ownership</h3>
        <p>
          We own or license the intellectual property rights in the services,
          including the source code, object code, app functionality, plugins,
          website content, text, graphics, logos, designs, documentation and
          related materials.
        </p>

        <h3>6.2 Licence grant</h3>
        <p>
          Subject to payment and compliance with these terms, we grant you a
          limited, personal, non-exclusive, non-transferable and revocable
          licence to access and use the purchased service for the applicable
          access period. The licence may expire, be suspended, restricted or
          revoked only as permitted by these terms.
        </p>

        <p>
          For Lifetime Access, the active access period is the Product Lifetime
          described in Section 7, followed by any Archived Product Access
          available under that section.
        </p>

        <h3>6.3 Licence restrictions</h3>
        <p>
          Unless applicable law prevents the restriction or we have expressly
          authorised the activity in writing, you must not:
        </p>

        <ul>
          <li>copy, sell, rent, share, sublicense, publish or distribute the services;</li>
          <li>share or transfer keys, files, account access or access entitlements;</li>
          <li>decompile, disassemble or reverse engineer the services;</li>
          <li>remove ownership notices or bypass licence, payment, HWID or security controls;</li>
          <li>modify or create derivative works from the services; or</li>
          <li>use the services to provide a commercial service to another person.</li>
        </ul>

        <h3>6.4 HWID rules</h3>
        <p>
          One HWID means one device, such as a PC, laptop or server. Activating a
          plugin binds it to that device for 30 days. Each later activation on
          that device restarts the 30-day period. You may run multiple plugin
          instances on an authorised HWID unless the relevant product page says
          otherwise, but use remains personal.
        </p>

        <p>
          To remove an HWID before the 30-day period ends, you may request an
          immediate reset for the fee disclosed at the time of the request. The
          current standard fee is USD $5. Creating or using another account to
          evade HWID limits, reset fees or enforcement is prohibited.
        </p>

        <p>
          Hardware changes, including CPU or motherboard changes, may create a
          new HWID. Where that happens, you must wait until the existing binding
          expires or request an immediate reset.
        </p>

        <p>Unless the product page or an order-specific notice states otherwise:</p>

        <ul>
          <li>Package access for 30, 60 or 90 days, or Lifetime Access: 2 HWIDs.</li>
          <li>PVM access for 30, 60 or 90 days, or Lifetime Access: 1 HWID.</li>
          <li>Combined Package and PVM access for 30, 60 or 90 days: 1 HWID.</li>
        </ul>

        <h3>6.5 Compatibility and updates</h3>
        <p>
          Updates may be required to continue using a product. We do not
          guarantee compatibility with every current or future platform version,
          application, operating system, device, hardware configuration,
          third-party service or update.
        </p>

        <p>
          Routine bug fixes, patches, maintenance, minor refactoring and ordinary
          compatibility updates do not by themselves end a Product Lifetime.
          Where an External Change would require Substantial Redevelopment,
          Section 7 applies.
        </p>
      </article>

      <article class="tos-card" id="lifetime">
        <h2>7. Lifetime Access and Product End of Life</h2>

        <h3>7.1 Meaning of Lifetime Access</h3>
        <p>
          Where a product is described or sold as providing “Lifetime Access”,
          this means access for the Product Lifetime of that specific product.
        </p>

        <p>
          “Lifetime” does not mean the natural lifetime of the customer, any
          other individual, ElPlugins, its owner, employees or contractors.
          Lifetime Access is personal, non-transferable and non-inheritable.
        </p>

        <p>
          Lifetime Access does not mean that the product will exist or operate
          forever. It does not guarantee perpetual development, updates, support,
          uninterrupted availability or compatibility with every future
          platform, system or third-party service.
        </p>

        <h3>7.2 Product Lifetime</h3>
        <p>
          The Product Lifetime begins when the product is first made
          commercially available and continues until a Product End of Life
          occurs under this section. Your Lifetime Access begins when your access
          entitlement is delivered and continues for the remainder of that
          Product Lifetime, subject to these terms.
        </p>

        <h3>7.3 External Change</h3>
        <p>
          An External Change is a material change outside our reasonable control
          affecting a product’s operation, compatibility, legality, security or
          distribution. This may include a material change to:
        </p>

        <ul>
          <li>a third-party platform, application, game or service;</li>
          <li>an API, software dependency, protocol or data format;</li>
          <li>an operating system, security system or authentication system;</li>
          <li>a hosting, infrastructure or distribution service;</li>
          <li>third-party technical requirements, terms or licences;</li>
          <li>applicable law, regulation or regulatory requirements; or</li>
          <li>another external system or dependency on which the product materially relies.</li>
        </ul>

        <h3>7.4 Substantial Redevelopment</h3>
        <p>
          Substantial Redevelopment means that, because of an External Change,
          keeping the product functioning and compatible would require the
          replacement, redesign or rewriting of a material part of its codebase
          or architecture and would, in substance, amount to developing a
          materially new product rather than maintaining the existing one.
        </p>

        <p>
          Substantial Redevelopment does not include routine maintenance,
          ordinary bug fixes, patches, minor code changes, minor refactoring or
          ordinary compatibility updates.
        </p>

        <p>
          We will assess reasonably and in good faith whether Substantial
          Redevelopment is required. Relevant factors include:
        </p>

        <ul>
          <li>the amount and complexity of code that must be replaced or rewritten;</li>
          <li>whether the existing architecture can reasonably be retained;</li>
          <li>whether material dependencies or components must be replaced;</li>
          <li>whether the product needs a material redesign;</li>
          <li>legal, technical and security risks; and</li>
          <li>whether the resulting software would in substance be a materially new product.</li>
        </ul>

        <p>
          Cost or commercial preference alone will not amount to Substantial
          Redevelopment where the work would otherwise be routine maintenance or
          an ordinary compatibility update.
        </p>

        <h3>7.5 Product End of Life</h3>
        <p>
          We may declare a Product End of Life only where:
        </p>

        <ol>
          <li>an External Change has occurred; and</li>
          <li>
            we reasonably and in good faith determine that keeping the product
            operational would require Substantial Redevelopment.
          </li>
        </ol>

        <p>
          We are not required to undertake Substantial Redevelopment as part of
          an existing Lifetime Access entitlement.
        </p>

        <p>
          Where Substantial Redevelopment is required, we may develop and offer
          the substantially redeveloped software as a separate successor
          product. Existing Lifetime Access does not automatically include the
          successor product unless we expressly state otherwise.
        </p>

        <p>
          A Product Lifetime also ends if ElPlugins permanently ceases operating
          and permanently ceases supplying all products and related services.
        </p>

        <h3>7.6 No artificial discontinuation</h3>
        <p>
          We will not end a Product Lifetime merely to rename, rebrand, repackage
          or resell substantially the same product as a new product.
        </p>

        <p>
          A change to a product’s name, branding, version number, price, delivery
          method or packaging does not by itself create a separate product or end
          its Product Lifetime.
        </p>

        <p>
          A successor may be treated as a separate product where an External
          Change required Substantial Redevelopment and the successor has a
          materially rewritten codebase, materially different architecture or
          other material technical differences, even if it serves a similar
          purpose or provides similar core functionality.
        </p>

        <h3>7.7 End-of-life notice</h3>
        <p>
          Where reasonably practicable, we will publish at least 30 days’ notice
          before Product End of Life. Shorter or immediate notice may be given
          where an urgent legal, security, technical or third-party platform
          issue makes that reasonably necessary.
        </p>

        <p>Where reasonably possible, the notice will identify:</p>

        <ul>
          <li>the affected product;</li>
          <li>the Product End-of-Life date;</li>
          <li>the general nature of the External Change;</li>
          <li>why continued operation would require Substantial Redevelopment;</li>
          <li>how eligible customers can request the Archived Version; and</li>
          <li>whether a separate successor product is available.</li>
        </ul>

        <p>
          We are not required to disclose source code, confidential information,
          security-sensitive information or information restricted by a third
          party.
        </p>

        <h3>7.8 Archived Product Access</h3>
        <p>
          After Product End of Life, a customer who purchased Lifetime Access
          may request the final Archived Version through the official support
          system.
        </p>

        <p>
          While ElPlugins continues operating, we will retain and make the
          Archived Version available to eligible Lifetime Access customers at no
          additional charge unless providing it:
        </p>

        <ul>
          <li>would be unlawful;</li>
          <li>would infringe third-party rights;</li>
          <li>is prohibited by a binding third-party restriction;</li>
          <li>would create a material security risk; or</li>
          <li>is no longer technically possible despite our reasonable efforts.</li>
        </ul>

        <p>
          We may provide the Archived Version by download, manual delivery or
          another reasonable method. We may require reasonable proof of purchase
          and account ownership.
        </p>

        <p>
          Archived Product Access provides the final available version of the
          original product only. It does not require us to develop, update,
          maintain, repair or support that version.
        </p>

        <p>The Archived Version may:</p>

        <ul>
          <li>have reduced, disabled or restricted functionality;</li>
          <li>no longer interact with third-party platforms or services;</li>
          <li>no longer receive updates, fixes or technical support;</li>
          <li>be incompatible with current or future systems;</li>
          <li>require an older platform, application or operating-system version;</li>
          <li>have online, server-side, authentication or integration features disabled;</li>
          <li>be unable to perform some or all of its original functions; or</li>
          <li>cease functioning entirely because of the External Change.</li>
        </ul>

        <p>
          We may remove or disable functionality where reasonably necessary
          because of legal, security, technical or third-party restrictions.
          Archived Product Access does not require us to maintain servers, APIs,
          authentication systems, integrations or other live infrastructure
          solely for an archived product.
        </p>

        <p>
          The Archived Version remains subject to the licence restrictions,
          HWID rules and acceptable-use provisions in these terms.
        </p>

        <h3>7.9 Temporary problems</h3>
        <p>
          Temporary downtime, maintenance, outages, compatibility problems,
          suspended sales, interrupted third-party services or delays in
          releasing an update do not by themselves constitute Product End of
          Life.
        </p>

        <p>
          Product End of Life occurs only when we give notice under this section
          or permanently cease all relevant business operations.
        </p>
      </article>

      <article class="tos-card" id="acceptable-use">
