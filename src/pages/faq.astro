---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { discordUrl } from '../config/site';

const faqs = [
  {
    question: 'Where can I find more information?',
    answer: 'You can find more information on the support channels, not on the Website. The support includes FAQ, support channels, community help, updates and package information.'
  },
  {
    question: 'Where do I get support?',
    answer: 'Support is handled through support channels. Use the available support request options.'
  },
  {
    question: 'Where are payment questions handled?',
    answer: 'Payment questions are handled through support channels. Contact support for help with available payment methods.'
  },
  {
    question: 'Where can I buy plugins?',
    answer: 'You can request through the catalogue. For questions before requesting access, contact support first.'
  },
  {
    question: 'Which package do I need?',
    answer: 'The Plugin Package covers Combat, Skilling, Minigames and Utility plugins. PVM Plugins covers the listed PVM plugins. The Plugin & PVM Package includes both.'
  },
  {
    question: 'Is help available after request?',
    answer: 'Yes. Help is available through support channels, including FAQ resources and community updates.'
  }
];
---

<BaseLayout
  title="FAQ - ElPlugins"
  description="Frequently asked questions for ElPlugins."
>
  <Navbar />

  <main>
    <section class="page-hero">
      <p class="eyebrow">FAQ</p>
      <h1>Frequently Asked Questions</h1>
      <p>
        Most detailed information is available on the support channels, including
        support, package help, updates, changelogs and community channels.
      </p>

      <div class="page-actions">
        <a class="button discord-button" href={discordUrl}>Contact Support</a>
      </div>
    </section>

    <section class="faq-list">
      {faqs.map((faq) => (
        <article>
          <h2>{faq.question}</h2>
          <p>{faq.answer}</p>
        </article>
      ))}
    </section>

    <section class="section center">
      <div class="section-heading">
        <p class="eyebrow">Still Need Help?</p>
        <h2>Contact Support</h2>
        <p>
          The website only contains basic information. The support channels are the best place
          to find more details, ask questions, read updates and get support.
        </p>
      </div>

      <div class="bottom-cta">
        <a class="button discord-button" href={discordUrl}>Contact Support</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
