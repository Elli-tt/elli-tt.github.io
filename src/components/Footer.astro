---
import {
  discordUrl,
  navItems,
  webstoreUrl,
  withBasePath
} from '../config/site';

const {
  hideLinks = false
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<footer class="footer">
  <div class="footer-brand">
    <img src={`${base}images/elpluginshdlogo.png`} alt="ElPlugins logo" class="footer-logo" />
    <h2>ElPlugins</h2>
    <p>For all your plugin needs.</p>
    <p class="made-by">Made with Astro</p>
  </div>

  {!hideLinks && (
    <div class="footer-links">
      {navItems.map((item) => (
        <a href={withBasePath(base, item.route)}>{item.label}</a>
      ))}
      <a href={webstoreUrl}>View Catalogue</a>
      <a href={discordUrl}>Contact Support</a>
    </div>
  )}

  <p class="copyright">© 2026 ElPlugins - ElPlugins.com</p>
</footer>
